{
  "manifest_version": 3,
  "name": "OPAL Redesign",
  "version": "0.2.0",
  "description": "A modern UI overlay for the OPAL learning platform.",
  "browser_specific_settings": {
    "gecko": {
      "id": "opal-redesign@just2it",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bildungsportal.sachsen.de/opal/*",
    "https://api.studentenwerk-dresden.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bildungsportal.sachsen.de/opal/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "styles/gridstack.css",
        "styles/hider.css",
        "styles/modern.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bildungsportal.sachsen.de/opal/*"
      ],
      "js": [
        "dist/main-world.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
