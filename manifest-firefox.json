{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.6",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "opal-redesign-public@just8it.github",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://bildungsportal.sachsen.de/opal/*",
    "https://api.studentenwerk-dresden.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bildungsportal.sachsen.de/opal/home*",
        "https://bildungsportal.sachsen.de/opal/",
        "https://bildungsportal.sachsen.de/opal",
        "https://bildungsportal.sachsen.de/opal/auth/RepositoryEntry/*",
        "https://bildungsportal.sachsen.de/opal/url/RepositoryEntry/*"
      ],
      "js": [
        "dist/early.js"
      ],
      "css": [
        "styles/hider.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://bildungsportal.sachsen.de/opal/*",
        "https://bildungsportal.sachsen.de/opal"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "styles/hider.css",
        "styles/modern.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bildungsportal.sachsen.de/opal/*",
        "https://bildungsportal.sachsen.de/opal"
      ],
      "js": [
        "dist/main-world.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "opal-search": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "__MSG_openSearch__"
    }
  }
}
